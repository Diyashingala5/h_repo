<odoo>

    <template id="patient_template">
        <t t-call="website.layout">
            <div class="container">
                <h1>Patients</h1>

                <t t-foreach="patients" t-as="p">
                    <p>
                        <t t-esc="p.name"/>
                    </p>
                </t>

            </div>
        </t>
    </template>
    
</odoo>